{
  "name": "@local/dsh-book-loom",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Traceable structural reading workbench for DeepSeek Harness",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "lib/parsers/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/watch.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/unit.mjs test/client-contract.mjs",
    "test:integration": "node --test test/integration.mjs",
    "test:performance": "node test/performance.mjs",
    "verify": "npm run build && npm run check && npm test && npm run test:integration && npm run test:performance"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "fflate": "^0.8.2",
    "iconv-lite": "^0.7.0",
    "jschardet": "^3.1.4",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.468.0",
    "marked": "^16.4.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.1"
  },
  "license": "MIT"
}
